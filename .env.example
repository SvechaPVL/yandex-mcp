# Yandex MCP Server Configuration
# Copy this file to .env and fill in your values

# Option 1: Single OAuth token for both services
# This token must have access to both Yandex Direct and Yandex Metrika
YANDEX_TOKEN=your_oauth_token_here

# Option 2: Separate tokens for each service
# YANDEX_DIRECT_TOKEN=your_direct_token_here
# YANDEX_METRIKA_TOKEN=your_metrika_token_here
# Webmaster API uses a separate OAuth scope; falls back to YANDEX_TOKEN if unset.
# YANDEX_WEBMASTER_TOKEN=your_webmaster_token_here

# Client login for agency accounts (optional)
# Required when managing campaigns for clients as an agency
# YANDEX_CLIENT_LOGIN=client_login

# Use Yandex Direct Sandbox for testing (optional)
# Set to "true" to use sandbox environment
# YANDEX_USE_SANDBOX=false

# Wordstat via Yandex Cloud Search API v2 (NOT OAuth!)
# Create a service account with search-api access in the Yandex Cloud console
# and issue an API key for it. The old api.wordstat.yandex.net is dead.
YANDEX_WORDSTAT_API_KEY=your_yandex_cloud_api_key_here
# Optional: folder ID for Search API v2 requests (usually not needed when the
# API key belongs to a service account inside a folder)
# YANDEX_CLOUD_FOLDER_ID=your_folder_id_here
